<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardPartidoPronostico"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:strokeColor="#E0E0E0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Cabecera: Fecha, Hora, Estadio y Estado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/lblFechaHoraPartido"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="12 de junio de 2026 - 16:00"
                android:textColor="#555555"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/lblEstadoPartido"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="ABIERTO"
                android:textColor="#2E7D32"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/lblEstadioPartido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:text="Estadio Azteca"
            android:textColor="#777777"
            android:textSize="12sp" />

        <!-- Subtítulo "Tu pronóstico" -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:text="Tu pronóstico"
            android:textAlignment="center"
            android:textColor="#102A43"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Sección Equipos y Marcador -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <!-- Selección 1 -->
            <LinearLayout
                android:id="@+id/filaSeleccion1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imgSeleccion1"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:contentDescription="Icono de la selección 1" />

                <TextView
                    android:id="@+id/lblSeleccion1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Selección 1"
                    android:textColor="#102A43"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Cajas de Entrada de Goles -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp">

                <EditText
                    android:id="@+id/txtGolesSel1"
                    android:layout_width="50dp"
                    android:layout_height="44dp"

                    android:gravity="center"
                    android:hint="0"
                    android:inputType="number"
                    android:maxLength="2"
                    android:textColor="#102A43"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="24dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="-"
                    android:textColor="#102A43"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/txtGolesSel2"
                    android:layout_width="50dp"
                    android:layout_height="44dp"

                    android:gravity="center"
                    android:hint="0"
                    android:inputType="number"
                    android:maxLength="2"
                    android:textColor="#102A43"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Selección 2 -->
            <LinearLayout
                android:id="@+id/filaSeleccion2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imgSeleccion2"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:contentDescription="Icono de la selección 2" />

                <TextView
                    android:id="@+id/lblSeleccion2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Selección 2"
                    android:textColor="#102A43"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

        <!-- Mensaje Informativo para Cerrado / Finalizado -->
        <TextView
            android:id="@+id/lblMensajeEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="8dp"
            android:textAlignment="center"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Botón Guardar Pronóstico -->
        <Button
            android:id="@+id/btnGuardarPronostico"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#008744"
            android:text="Guardar pronóstico"
            android:textColor="@android:color/white"
            android:textSize="14sp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
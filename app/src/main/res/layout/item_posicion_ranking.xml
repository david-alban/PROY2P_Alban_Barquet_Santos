<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/containerFila"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/input_redondeado"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="14dp"
    android:weightSum="10">

    <TextView
        android:id="@+id/lblPos"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2"
        android:fontFamily="sans-serif-condensed-medium"
        android:text="1"
        android:textAlignment="center"
        android:textColor="#FBBF24"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/lblParticipante"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="5"
        android:fontFamily="sans-serif-condensed-medium"
        android:text="Juan Pérez"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/lblPuntos"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="3"
        android:fontFamily="sans-serif-condensed-medium"
        android:text="125 pts"
        android:textAlignment="center"
        android:textColor="#10B981"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>
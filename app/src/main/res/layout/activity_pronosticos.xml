<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo4"
    tools:context=".PronosticosActivity">

    <LinearLayout
        android:id="@+id/layoutPronosticos"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="1dp"
        android:layout_marginTop="1dp"
        android:layout_marginEnd="1dp"
        android:layout_marginBottom="1dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <include
            layout="@layout/header_usuario"
            android:layout_width="match_parent"
            android:layout_height="140dp" />

        <TextView
            android:id="@+id/lblTituloPronosticos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="Registrar Pronosticos"
            android:textAlignment="center"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lblSeleccionFase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Seleccione la fase del torneo"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spFase"
            android:layout_width="match_parent"
            android:layout_height="49dp" />

        <ScrollView
            android:id="@+id/scrollPartidosPronostico"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:rotationX="0">

            <LinearLayout
                android:id="@+id/contenedorPartidos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp" />
        </ScrollView>

        <Button
            android:id="@+id/btnVolverPronosticos"
            android:layout_width="wrap_content"
            android:layout_height="55dp"
            android:layout_marginBottom="6dp"
            android:elevation="0dp"
            android:gravity="center|center_vertical"
            android:paddingEnd="0dp"
            android:paddingBottom="0dp"
            android:text="Volver"
            android:textAlignment="center" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>